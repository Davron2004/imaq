{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "../worker-configuration.d.ts"
    ]
  },
  "include": [
    ".",
    "../shared"
  ],
  "exclude": [
    "test",
    "**/*.test.ts",
    "../shared/**/*.test.ts"
  ]
}
